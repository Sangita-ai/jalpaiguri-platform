generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis(schema: "public"), uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

model User {
  id                   String         @id @default(uuid()) @db.Uuid
  email                String         @unique @db.VarChar(255)
  password_hash        String         @db.VarChar(255)
  full_name            String         @db.VarChar(255)
  full_name_bn         String?        @db.VarChar(255)
  phone                String?        @db.VarChar(15)
  role                 UserRole       @default(CITIZEN)
  ward_id              Int?
  avatar_url           String?        @db.VarChar(500)
  is_active            Boolean        @default(true)
  last_login_at        DateTime?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt
  assigned_by_me       Assignment[]   @relation("OfficerAssignments")
  assigned_tasks       Assignment[]   @relation("WorkerAssignments")
  audit_logs           AuditLog[]
  submitted_complaints Complaint[]    @relation("CitizenComplaints")
  notifications        Notification[]
  refresh_tokens       RefreshToken[]
  ward                 Ward?          @relation(fields: [ward_id], references: [id])

  @@index([email])
  @@index([role])
  @@index([ward_id])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @unique @db.VarChar(255)
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("refresh_tokens")
}

model Ward {
  id                Int              @id
  name              String           @db.VarChar(100)
  name_bn           String           @db.VarChar(100)
  officer_id        String?          @db.Uuid
  population        Int              @default(0)
  area_sqkm         Float            @default(0)
  created_at        DateTime         @default(now())
  complaints        Complaint[]
  drain_sensors     DrainSensor[]
  green_cover_stats GreenCoverStat[]
  trees             Tree[]
  users             User[]
  water_pipes       WaterPipe[]

  @@map("wards")
}

model Complaint {
  id              String                @id @default(uuid()) @db.Uuid
  complaint_no    String                @unique @db.VarChar(30)
  citizen_id      String                @db.Uuid
  ward_id         Int
  category        ComplaintCategory
  description     String
  address         String?               @db.VarChar(500)
  latitude        Float?
  longitude       Float?
  status          ComplaintStatus       @default(SUBMITTED)
  priority        ComplaintPriority     @default(MEDIUM)
  priority_score  Int                   @default(50)
  ai_category     ComplaintCategory?
  ai_summary      String?
  is_duplicate    Boolean               @default(false)
  duplicate_of    String?               @db.Uuid
  submitted_at    DateTime              @default(now())
  acknowledged_at DateTime?
  resolved_at     DateTime?
  closed_at       DateTime?
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt
  assignment      Assignment?
  attachments     ComplaintAttachment[]
  citizen         User                  @relation("CitizenComplaints", fields: [citizen_id], references: [id])
  ward            Ward                  @relation(fields: [ward_id], references: [id])
  notifications   Notification[]

  @@index([complaint_no])
  @@index([citizen_id])
  @@index([ward_id])
  @@index([category])
  @@index([status])
  @@index([submitted_at])
  @@index([priority_score])
  @@map("complaints")
}

model ComplaintAttachment {
  id           String    @id @default(uuid()) @db.Uuid
  complaint_id String    @db.Uuid
  s3_url       String    @db.VarChar(1000)
  s3_key       String    @db.VarChar(500)
  file_name    String    @db.VarChar(255)
  file_type    String    @db.VarChar(50)
  file_size_kb Int       @default(0)
  captured_at  DateTime?
  uploaded_at  DateTime  @default(now())
  complaint    Complaint @relation(fields: [complaint_id], references: [id], onDelete: Cascade)

  @@index([complaint_id])
  @@map("complaint_attachments")
}

model Assignment {
  id                   String    @id @default(uuid()) @db.Uuid
  complaint_id         String    @unique @db.Uuid
  worker_id            String    @db.Uuid
  assigned_by          String    @db.Uuid
  assigned_at          DateTime  @default(now())
  due_at               DateTime
  started_at           DateTime?
  completed_at         DateTime?
  notes                String?
  completion_photo_url String?   @db.VarChar(1000)
  completion_notes     String?
  assigned_by_user     User      @relation("OfficerAssignments", fields: [assigned_by], references: [id])
  complaint            Complaint @relation(fields: [complaint_id], references: [id], onDelete: Cascade)
  worker               User      @relation("WorkerAssignments", fields: [worker_id], references: [id])

  @@index([worker_id])
  @@index([assigned_at])
  @@index([due_at])
  @@map("assignments")
}

model SlaConfig {
  id               Int               @id @default(autoincrement())
  category         ComplaintCategory @unique
  target_hours     Int
  escalation_hours Int
  priority         ComplaintPriority @default(MEDIUM)
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  @@map("sla_config")
}

model Tree {
  id            String           @id @default(uuid()) @db.Uuid
  ward_id       Int
  species_name  String           @db.VarChar(200)
  species_bn    String?          @db.VarChar(200)
  common_name   String?          @db.VarChar(200)
  latitude      Float
  longitude     Float
  height_m      Float            @default(5.0)
  crown_dia_m   Float            @default(3.0)
  trunk_dia_cm  Float            @default(20.0)
  health_status TreeHealthStatus @default(HEALTHY)
  planted_at    DateTime?        @db.Date
  surveyed_at   DateTime         @default(now())
  carbon_kg     Float            @default(0)
  survey_source SurveySource     @default(FIELD_SURVEY)
  notes         String?
  is_heritage   Boolean          @default(false)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  ward          Ward             @relation(fields: [ward_id], references: [id])

  @@index([ward_id])
  @@index([species_name])
  @@index([health_status])
  @@map("trees")
}

model GreenCoverStat {
  id              Int      @id @default(autoincrement())
  ward_id         Int
  green_area_sqm  Float    @default(0)
  total_area_sqm  Float    @default(0)
  cover_pct       Float    @default(0)
  tree_count      Int      @default(0)
  carbon_total_kg Float    @default(0)
  calculated_at   DateTime @default(now())
  ward            Ward     @relation(fields: [ward_id], references: [id])

  @@index([ward_id])
  @@map("green_cover_stats")
}

model DrainSensor {
  id                String            @id @default(uuid()) @db.Uuid
  ward_id           Int
  sensor_code       String            @unique @db.VarChar(30)
  latitude          Float
  longitude         Float
  location_desc     String?           @db.VarChar(500)
  capacity_cm       Float             @default(100)
  current_level_cm  Float             @default(0)
  status            DrainSensorStatus @default(NORMAL)
  overflow_risk_pct Float             @default(0)
  last_reading      DateTime?
  is_active         Boolean           @default(true)
  installed_at      DateTime          @default(now())
  readings          DrainReading[]
  ward              Ward              @relation(fields: [ward_id], references: [id])

  @@index([ward_id])
  @@index([status])
  @@map("drain_sensors")
}

model DrainReading {
  id            String      @id @default(uuid()) @db.Uuid
  sensor_id     String      @db.Uuid
  level_cm      Float
  rainfall_mm   Float       @default(0)
  temperature_c Float?
  recorded_at   DateTime    @default(now())
  sensor        DrainSensor @relation(fields: [sensor_id], references: [id], onDelete: Cascade)

  @@index([sensor_id, recorded_at(sort: Desc)])
  @@index([recorded_at(sort: Desc)])
  @@map("drain_readings")
}

model WaterPipe {
  id            String        @id @default(uuid()) @db.Uuid
  ward_id       Int
  pipe_code     String        @unique @db.VarChar(30)
  diameter_mm   Int           @default(100)
  material      String        @db.VarChar(100)
  length_m      Float         @default(0)
  install_year  Int?
  status        PipeStatus    @default(ACTIVE)
  pressure_zone String?       @db.VarChar(50)
  created_at    DateTime      @default(now())
  ward          Ward          @relation(fields: [ward_id], references: [id])
  sensors       WaterSensor[]

  @@index([ward_id])
  @@index([status])
  @@map("water_pipes")
}

model WaterSensor {
  id                 String          @id @default(uuid()) @db.Uuid
  pipe_id            String          @db.Uuid
  sensor_code        String          @unique @db.VarChar(30)
  latitude           Float
  longitude          Float
  pressure_bar       Float           @default(3.0)
  flow_lpm           Float           @default(50.0)
  leak_probability   Float           @default(0)
  alert_level        WaterAlertLevel @default(NORMAL)
  estimated_loss_lph Float           @default(0)
  last_reading       DateTime?
  is_active          Boolean         @default(true)
  pipe               WaterPipe       @relation(fields: [pipe_id], references: [id], onDelete: Cascade)

  @@index([pipe_id])
  @@index([alert_level])
  @@map("water_sensors")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  user_id     String      @db.Uuid
  action      AuditAction
  entity_type String      @db.VarChar(50)
  entity_id   String?     @db.Uuid
  old_value   Json?
  new_value   Json?
  ip_address  String?     @db.VarChar(45)
  user_agent  String?     @db.VarChar(500)
  created_at  DateTime    @default(now())
  user        User        @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([entity_type, entity_id])
  @@index([created_at(sort: Desc)])
  @@map("audit_logs")
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  user_id      String           @db.Uuid
  complaint_id String?          @db.Uuid
  type         NotificationType
  title        String           @db.VarChar(255)
  message      String
  is_read      Boolean          @default(false)
  read_at      DateTime?
  created_at   DateTime         @default(now())
  complaint    Complaint?       @relation(fields: [complaint_id], references: [id])
  user         User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@index([created_at(sort: Desc)])
  @@map("notifications")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum UserRole {
  CITIZEN
  FIELD_WORKER
  DEPARTMENT_HEAD
  MUNICIPAL_OFFICER
  CHAIRMAN
  SUPER_ADMIN
}

enum ComplaintCategory {
  GARBAGE
  WATER_LEAKAGE
  WATER_SUPPLY
  DRAINAGE
  ROAD_DAMAGE
  STREETLIGHT_FAILURE
  ILLEGAL_DUMPING
  OTHER
}

enum ComplaintStatus {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TreeHealthStatus {
  HEALTHY
  STRESSED
  DISEASED
  DEAD
  REMOVED
}

enum DrainSensorStatus {
  NORMAL
  WARNING
  CRITICAL
  OFFLINE
}

enum WaterAlertLevel {
  NORMAL
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PipeStatus {
  ACTIVE
  UNDER_REPAIR
  DECOMMISSIONED
}

enum SurveySource {
  SATELLITE
  DRONE
  FIELD_SURVEY
  CITIZEN_REPORT
}

enum NotificationType {
  COMPLAINT_SUBMITTED
  COMPLAINT_ASSIGNED
  STATUS_UPDATE
  SLA_BREACH
  SENSOR_ALERT
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ASSIGN
  RESOLVE
}
