# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/jalpaiguri_platform?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production-min-32-chars"

# App
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# AWS / MinIO (S3-compatible)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="jalpaiguri-platform"
S3_ENDPOINT="http://localhost:9000"

# AI (Anthropic)
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# Mapbox
MAPBOX_SECRET_TOKEN="sk.your-mapbox-secret"
